# Generated per-account inventory files (account-specific, regenerated by
# scripts/generate_account_inventories.py) -- keep the directory, not its
# generated contents.
ansible/inventory/accounts/*
!ansible/inventory/accounts/.gitkeep

# Ansible
*.retry
/tmp/ansible_fact_cache/
/tmp/ansible_inventory_cache/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
